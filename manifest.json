{
  "manifest_version": 3,
  "name": "y3s — playlist tools for YouTube",
  "short_name": "y3s",
  "version": "0.4.0",
  "description": "Filter, sort, multi-select, keyboard navigation and bulk edits, built into YouTube's own playlist pages.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "identity"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "9744192329-4llnr7vq1a8vghbqblq5360sogkbh59d.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/youtube"
    ]
  },
  "minimum_chrome_version": "114"
}
